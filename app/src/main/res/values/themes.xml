<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Main Application Theme (No Action Bar) -->
    <style name="Theme.RozgarMitra" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0F172A</item>
        <item name="android:statusBarColor">#0F172A</item>
        <item name="android:navigationBarColor">#0F172A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Splash Theme for OS Launch Transition -->
    <style name="Theme.RozgarMitra.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground" tools:targetApi="31">#0F172A</item>
        <item name="windowSplashScreenAnimatedIcon" tools:targetApi="31">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.RozgarMitra</item>
    </style>

</resources>