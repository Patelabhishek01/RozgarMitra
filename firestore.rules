rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    // Check if user has OWNER role
    function isOwnerUser(uid) {
      let userPath = /databases/$(database)/documents/users/$(uid);
      return exists(userPath) && get(userPath).data.role == "OWNER";
    }

    // Check if chat is authorized for an application
    function isValidApplicationChat(conv) {
      let appPath = /databases/$(database)/documents/applications/$(conv.applicationId);
      return exists(appPath) &&
        get(appPath).data.jobId == conv.jobId &&
        get(appPath).data.ownerId == conv.ownerId &&
        get(appPath).data.labourId == conv.workerId &&
        (get(appPath).data.get("chatApproved", false) == true || 
         get(appPath).data.status == "ACCEPTED" || 
         get(appPath).data.status == "COMPLETED");
    }

    // Check if user is participant of thread
    function isThreadParticipant(threadId) {
      let threadPath = /databases/$(database)/documents/conversations/$(threadId);
      return exists(threadPath) &&
        (request.auth.uid in get(threadPath).data.participants ||
         get(threadPath).data.ownerId == request.auth.uid ||
         get(threadPath).data.workerId == request.auth.uid) &&
        isValidApplicationChat(get(threadPath).data);
    }

    // --- JOBS COLLECTION ---
    // READ: Public / Unauthenticated users allowed to browse jobs
    // CREATE: Authenticated OWNER users (must specify ownerId == auth.uid)
    // UPDATE / DELETE: Authenticated Owner only for their own posted job, ownerId immutable
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if request.auth != null && 
        request.resource.data.ownerId == request.auth.uid &&
        isOwnerUser(request.auth.uid);
      allow update: if request.auth != null && 
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if request.auth != null && 
        resource.data.ownerId == request.auth.uid;
    }

    // --- USERS COLLECTION ---
    // User Privacy: User can only read/write their own document
    // Protection: id, role, isVerified cannot be spoofed by client. verificationStatus can only transition to PENDING.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      
      allow create: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.id == userId &&
        (request.resource.data.role == "LABOUR" || request.resource.data.role == "OWNER") &&
        request.resource.data.get("isVerified", false) == false &&
        (request.resource.data.get("verificationStatus", "") == "" || request.resource.data.get("verificationStatus", "") == "PENDING");

      allow update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.get("isVerified", false) == resource.data.get("isVerified", false) &&
        (
          request.resource.data.get("verificationStatus", "") == resource.data.get("verificationStatus", "") ||
          (resource.data.get("verificationStatus", "") != "VERIFIED" && request.resource.data.get("verificationStatus", "") == "PENDING")
        );

      allow delete: if false;
    }

    // --- APPLICATIONS COLLECTION ---
    // READ: Worker (labourId) or Owner (ownerId) related to application
    // CREATE: Authenticated worker creating application for themselves with status APPLIED, validated against job ownerId
    // UPDATE: Owner can update status / chatApproved; Worker can update non-critical fields but cannot alter status to ACCEPTED/REJECTED/COMPLETED or set chatApproved
    // Immutability: ownerId, labourId, jobId, appliedAt cannot be changed
    match /applications/{applicationId} {
      allow read: if request.auth != null && 
        (resource.data.labourId == request.auth.uid || resource.data.ownerId == request.auth.uid);
      
      allow create: if request.auth != null && 
        request.resource.data.labourId == request.auth.uid &&
        request.resource.data.status == "APPLIED" &&
        (!("chatApproved" in request.resource.data) || request.resource.data.chatApproved == false) &&
        exists(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)) &&
        request.resource.data.ownerId == get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.ownerId;
        
      allow update: if request.auth != null &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.labourId == resource.data.labourId &&
        request.resource.data.jobId == resource.data.jobId &&
        (!("appliedAt" in request.resource.data) || request.resource.data.appliedAt == resource.data.appliedAt) &&
        (
          resource.data.ownerId == request.auth.uid ||
          (
            resource.data.labourId == request.auth.uid &&
            request.resource.data.status != "ACCEPTED" &&
            request.resource.data.status != "REJECTED" &&
            request.resource.data.status != "COMPLETED" &&
            request.resource.data.get("chatApproved", false) == resource.data.get("chatApproved", false)
          )
        );
      
      allow delete: if request.auth != null && 
        (resource.data.labourId == request.auth.uid || resource.data.ownerId == request.auth.uid);
    }

    // --- NOTIFICATIONS COLLECTION ---
    // Recipient-private read, update, and delete; create strictly validated against domain relationships
    match /notifications/{notificationId} {
      allow read, update, delete: if request.auth != null && 
        resource.data.recipientUserId == request.auth.uid;

      allow create: if request.auth != null && (
        // Self-notification
        request.resource.data.recipientUserId == request.auth.uid ||
        (
          request.resource.data.recipientUserId != request.auth.uid &&
          (
            // 1. Worker applying for job notifies job owner
            (
              request.resource.data.type == "APPLICATION_SUBMITTED" &&
              exists(/databases/$(database)/documents/jobs/$(request.resource.data.relatedJobId)) &&
              get(/databases/$(database)/documents/jobs/$(request.resource.data.relatedJobId)).data.ownerId == request.resource.data.recipientUserId
            ) ||
            // 2. Owner accepting/rejecting application or approving chat notifies applicant
            (
              (request.resource.data.type == "APPLICATION_ACCEPTED" || 
               request.resource.data.type == "APPLICATION_REJECTED" || 
               request.resource.data.type == "CHAT_APPROVED") &&
              exists(/databases/$(database)/documents/applications/$(request.resource.data.relatedApplicationId)) &&
              get(/databases/$(database)/documents/applications/$(request.resource.data.relatedApplicationId)).data.ownerId == request.auth.uid &&
              get(/databases/$(database)/documents/applications/$(request.resource.data.relatedApplicationId)).data.labourId == request.resource.data.recipientUserId
            ) ||
            // 3. Participant sending a chat message notifies thread recipient
            (
              request.resource.data.type == "NEW_MESSAGE" &&
              exists(/databases/$(database)/documents/conversations/$(request.resource.data.relatedThreadId)) &&
              request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.relatedThreadId)).data.participants &&
              request.resource.data.recipientUserId in get(/databases/$(database)/documents/conversations/$(request.resource.data.relatedThreadId)).data.participants
            ) ||
            // 4. Job status change notification from owner
            (
              request.resource.data.type == "JOB_STATUS_CHANGED" &&
              exists(/databases/$(database)/documents/jobs/$(request.resource.data.relatedJobId)) &&
              get(/databases/$(database)/documents/jobs/$(request.resource.data.relatedJobId)).data.ownerId == request.auth.uid
            )
          )
        )
      );
    }

    // --- CONVERSATIONS COLLECTION ---
    // Only authorized participants (Owner & Worker) of a valid application can read/create/update conversation
    // Immutability: ownerId, workerId, jobId, applicationId, participants cannot be altered after creation
    match /conversations/{threadId} {
      allow read: if request.auth != null && 
        (resource.data.ownerId == request.auth.uid || resource.data.workerId == request.auth.uid || request.auth.uid in resource.data.participants) &&
        isValidApplicationChat(resource.data);

      allow create: if request.auth != null && 
        (request.resource.data.ownerId == request.auth.uid || request.resource.data.workerId == request.auth.uid || request.auth.uid in request.resource.data.participants) &&
        request.resource.data.participants.hasAll([request.resource.data.ownerId, request.resource.data.workerId]) &&
        request.resource.data.participants.size() == 2 &&
        isValidApplicationChat(request.resource.data);

      allow update: if request.auth != null && 
        (resource.data.ownerId == request.auth.uid || resource.data.workerId == request.auth.uid || request.auth.uid in resource.data.participants) &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.workerId == resource.data.workerId &&
        request.resource.data.jobId == resource.data.jobId &&
        request.resource.data.applicationId == resource.data.applicationId &&
        request.resource.data.participants == resource.data.participants &&
        isValidApplicationChat(resource.data);

      allow delete: if false;
    }

    // --- MESSAGES COLLECTION ---
    // Only authorized participants of thread can read/create messages
    match /messages/{messageId} {
      allow read: if request.auth != null && 
        isThreadParticipant(resource.data.threadId);

      allow create: if request.auth != null && 
        request.resource.data.senderId == request.auth.uid &&
        isThreadParticipant(request.resource.data.threadId);

      allow update, delete: if false;
    }

    // --- RATINGS COLLECTION ---
    // Anyone can read ratings; create restricted to reviewerId == auth.uid & job status COMPLETED & deterministic ID & verified owner/worker relationship
    match /ratings/{ratingId} {
      allow read: if true;

      allow create: if request.auth != null && 
        request.resource.data.reviewerId == request.auth.uid &&
        ratingId == "rating_" + request.resource.data.jobId + "_" + request.auth.uid &&
        exists(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)) &&
        get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.status == "COMPLETED" &&
        (
          // Reviewer is Job Owner rating the target worker
          (
            get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.ownerId == request.auth.uid &&
            request.resource.data.targetId != request.auth.uid
          ) ||
          // Reviewer is Worker rating the job owner
          (
            get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.ownerId == request.resource.data.targetId &&
            request.resource.data.reviewerId != request.resource.data.targetId
          )
        );

      allow update, delete: if false;
    }
  }
}
