rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- JOBS COLLECTION ---
    // READ: Public / Unauthenticated users are allowed to browse active jobs
    // CREATE: Authenticated users only
    // UPDATE / DELETE: Authenticated Owner only for their own posted job
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // --- USERS COLLECTION ---
    // Users can read/write their own user profile document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // --- APPLICATIONS COLLECTION ---
    // Owner or Labour related to the application can read/write
    match /applications/{applicationId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == resource.data.labourId || 
         request.auth.uid == resource.data.ownerId || 
         request.auth.uid == request.resource.data.labourId || 
         request.auth.uid == request.resource.data.ownerId);
    }

    // --- NOTIFICATIONS COLLECTION ---
    // Users can read/write their own notifications
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null && 
        (resource == null || resource.data.recipientUserId == request.auth.uid || request.resource.data.recipientUserId == request.auth.uid);
    }

    // --- CONVERSATIONS COLLECTION ---
    // Participants in the chat thread can access
    match /conversations/{threadId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid in resource.data.participants || 
         request.auth.uid in request.resource.data.participants);
    }

    // --- MESSAGES COLLECTION ---
    // Authenticated users can send/read messages
    match /messages/{messageId} {
      allow read, create: if request.auth != null;
    }
  }
}
