rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- JOBS COLLECTION ---
    // READ: Public / Unauthenticated users are allowed to browse active jobs
    // CREATE: Authenticated users (must specify ownerId == auth.uid)
    // UPDATE / DELETE: Authenticated Owner only for their own posted job
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // --- USERS COLLECTION ---
    // Authenticated users can read profiles; only owner can write/update their profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // --- APPLICATIONS COLLECTION ---
    // READ: Worker (labourId) or Owner (ownerId) related to the application
    // CREATE: Authenticated worker creating application for themselves with status APPLIED
    // UPDATE: Owner can update status / chatApproved; Worker can only update without setting ACCEPTED/REJECTED/COMPLETED and without setting chatApproved
    // DELETE: Worker or Owner related to the application
    match /applications/{applicationId} {
      allow read: if request.auth != null && 
        (resource.data.labourId == request.auth.uid || resource.data.ownerId == request.auth.uid);
      
      allow create: if request.auth != null && 
        request.resource.data.labourId == request.auth.uid &&
        request.resource.data.status == "APPLIED";
        
      allow update: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.labourId == request.auth.uid &&
         request.resource.data.status != "ACCEPTED" &&
         request.resource.data.status != "REJECTED" &&
         request.resource.data.status != "COMPLETED" &&
         (!("chatApproved" in request.resource.data) || request.resource.data.chatApproved == resource.data.get("chatApproved", false)))
      );
      
      allow delete: if request.auth != null && 
        (resource.data.labourId == request.auth.uid || resource.data.ownerId == request.auth.uid);
    }

    // --- NOTIFICATIONS COLLECTION ---
    // Users can read/write their own notifications
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null && 
        (resource == null || resource.data.recipientUserId == request.auth.uid || request.resource.data.recipientUserId == request.auth.uid);
    }

    // --- CONVERSATIONS COLLECTION ---
    // Helper function to check if chat is authorized for an application
    function isApplicationChatApproved(appId) {
      let app = get(/databases/$(database)/documents/applications/$(appId)).data;
      return app.status == "ACCEPTED" || app.status == "COMPLETED" || app.get("chatApproved", false) == true;
    }

    // Only authorized participants of the chat thread can read/write if chat is approved
    match /conversations/{threadId} {
      allow read: if request.auth != null && 
        (resource == null || (request.auth.uid in resource.data.participants && isApplicationChatApproved(resource.data.applicationId)));
      allow create: if request.auth != null && 
        (request.auth.uid in request.resource.data.participants) &&
        isApplicationChatApproved(request.resource.data.applicationId);
      allow update, delete: if request.auth != null && 
        (request.auth.uid in resource.data.participants) &&
        isApplicationChatApproved(resource.data.applicationId);
    }

    // --- MESSAGES COLLECTION ---
    // Helper function to check if sender is participant of thread
    function isThreadParticipant(threadId) {
      let thread = get(/databases/$(database)/documents/conversations/$(threadId)).data;
      return request.auth.uid in thread.participants;
    }

    // Only sender or receiver can read; only participant sender can create message with senderId == auth.uid
    match /messages/{messageId} {
      allow read: if request.auth != null && 
        (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if request.auth != null && 
        request.resource.data.senderId == request.auth.uid &&
        isThreadParticipant(request.resource.data.threadId);
    }

    // --- RATINGS COLLECTION ---
    // Anyone can read ratings; create restricted to reviewerId == auth.uid
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.reviewerId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
